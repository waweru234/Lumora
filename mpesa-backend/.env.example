# ---- Environment: "sandbox" for testing, "production" for live ----
MPESA_ENV=sandbox

# Daraja OAuth
DARAJA_CONSUMER_KEY=your_consumer_key_here
DARAJA_CONSUMER_SECRET=your_consumer_secret_here

# Shortcode (Paybill or Till) issued by Safaricom
# Sandbox defaults provided by Daraja docs:
#   Paybill 174379, Till 174379
MPESA_SHORTCODE=174379
MPESA_SHORTCODE_TYPE=paybill   # "paybill" or "till"

# Lipa Na M-Pesa Online passkey (from Daraja portal)
# Sandbox test passkey from Daraja docs:
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public URL Daraja will POST callbacks to. MUST be reachable from the internet.
# Use ngrok in dev: https://<your-subdomain>.ngrok.io
CALLBACK_BASE_URL=https://your-public-host.example.com

# Server
PORT=3000
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
